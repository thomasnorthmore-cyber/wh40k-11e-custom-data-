l-0-weapon-5-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000587-model-0-weapon-5-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000587-model-0-weapon-5-profile" name="Witchblade" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">2</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">2</characteristic><characteristic name="Keywords" typeId="fd-mkw">anti-infantry 2+, psychic</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="45" /></costs><modifiers><modifier type="set" field="pts-11e0" value="90"><conditions><condition type="atLeast" value="2" field="selections" scope="parent" childId="source-000000587-model-0" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry><selectionEntry id="source-aeldari-000000588" name="Spiritseer" hidden="false" type="unit"><profiles><profile id="source-000000588-stats-0" name="Spiritseer" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">6+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">3</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000000588-ability-2" name="Spiritseer" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is within 3" of one or more friendly Wraith Construct units, this model has the Lone Operative ability.</characteristic></characteristics></profile><profile id="source-000000588-ability-3" name="Spirit Mark (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Once per turn, in your Movement phase, when this model starts or ends a move, select one friendly Wraith Construct unit within 6" of this model (excluding TITANIC units) and one enemy unit visible to this model. Until the start of your next Movement phase, weapons equipped by models in that friendly unit have the [SUSTAINED HITS 1] ability while targeting that enemy unit.</characteristic></characteristics></profile><profile id="source-000000588-ability-4" name="Tears of Isha (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Command phase, select one friendly Wraith Construct unit within 6" of this model. If one or more models in that unit are destroyed, you can return one destroyed model to that unit. Otherwise, one model in that unit regains up to D3 lost wounds. Each unit can only be selected for this ability once per turn.</characteristic></characteristics></profile><profile id="source-000000588-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Infantry, Psyker, Aeldari, Character, Spiritseer</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani, </characteristic></characteristics></profile></profiles><rules><rule id="source-000000588-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: shuriken pistol; witch staff.</description></rule><rule id="source-000000588-composition" name="Unit Composition" hidden="false"><description>1 Spiritseer</description></rule><rule id="source-000000588-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 50 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000588-role" name="Character" targetId="smoke-cat-1" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000588-model-0" name="Spiritseer" hidden="false" type="model"><constraints><constraint id="source-000000588-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000588-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000588-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000588-model-0-weapon-0" name="Shuriken pistol" hidden="false" type="upgrade"><constraints><constraint id="source-000000588-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000588-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000588-model-0-weapon-0-profile" name="Shuriken pistol" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">12"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault, pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000000588-model-0-weapon-1" name="Witch staff" hidden="false" type="upgrade"><constraints><constraint id="source-000000588-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000588-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000588-model-0-weapon-1-profile" name="Witch staff" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">2</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">D3</characteristic><characteristic name="Keywords" typeId="fd-mkw">anti-infantry 2+, psychic</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="50" /></costs></selectionEntry><selectionEntry id="source-aeldari-000000590" name="Storm Guardians" hidden="false" type="unit"><profiles><profile id="source-000000590-stats-0" name="Storm Guardian" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">1</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="source-000000590-stats-1" name="Serpent’S Scale Platform" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">2</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">0</characteristic></characteristics></profile><profile id="source-000000590-ability-1" name="Stormblades" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the end of your Command phase, if this unit is within range of an objective marker you control, that objective marker remains under your control until your opponent’s Level of Control over that objective marker is greater than yours at the end of a phase.</characteristic></characteristics></profile><profile id="source-000000590-ability-2" name="Crewed Platform" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When the last Storm Guardian model in this unit is destroyed, any remaining Serpent’s Scale Platform models in this unit are also destroyed.</characteristic></characteristics></profile><profile id="source-000000590-ability-3" name="Serpent Shield" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Models in the bearer’s unit have a 5+ invulnerable save.</characteristic></characteristics></profile><profile id="source-000000590-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Grenades, Infantry, Battleline, Aeldari, Guardians, Storm Guardians</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000000590-starting" name="Starting Equipment" hidden="false"><description>Every Storm Guardian is equipped with: shuriken pistol; close combat weapon.

The Serpent’s Scale Platform is equipped with: close combat weapon; Serpent shield.</description></rule><rule id="source-000000590-composition" name="Unit Composition" hidden="false"><description>10 Storm Guardians; 1 Serpent’s Scale Platform</description></rule><rule id="source-000000590-option-0" name="Wargear Option 1" hidden="false"><description>Up to 2 Storm Guardians can each have their shuriken pistol replaced with 1 flamer.</description></rule><rule id="source-000000590-option-1" name="Wargear Option 2" hidden="false"><description>Up to 2 Storm Guardians can each have their shuriken pistol replaced with 1 fusion gun.</description></rule><rule id="source-000000590-option-2" name="Wargear Option 3" hidden="false"><description>Up to 2 Storm Guardians can each have their close combat weapon replaced with 1 power sword.</description></rule><rule id="source-000000590-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 11 models = 100 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000590-role" name="Battleline" targetId="smoke-cat-9" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000590-model-0" name="Storm Guardians" hidden="false" type="model"><constraints><constraint id="source-000000590-model-0-min" type="min" field="selections" scope="parent" value="10" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000590-model-0-max" type="max" field="selections" scope="parent" value="10" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000590-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000590-model-0-weapon-0" name="Flamer" hidden="false" type="upgrade"><constraints><constraint id="sou