aracteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">8</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">2</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="380" /></costs><modifiers><modifier type="set" field="pts-11e0" value="400"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="source-000003913-model-0" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry><selectionEntry id="source-aeldari-000003914" name="Ynnari Archon" hidden="false" type="unit"><profiles><profile id="source-000003914-stats-0" name="Ynnari Archon" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">8"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">2+</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000003914-ability-3" name="Overlord" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, each time a model in that unit makes an attack, re-roll a Wound roll of 1. While that unit is below its Starting Strength, each time a model in that unit makes an attack, you can re-roll the Wound roll instead.</characteristic></characteristics></profile><profile id="source-000003914-ability-4" name="Reborn Mastermind" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Once per battle round, one model from your army with this ability can use it when its unit is targeted with a Stratagem. If it does, reduce the CP cost of that usage of that Stratagem by 1CP.</characteristic></characteristics></profile><profile id="source-000003914-ability-5" name="Shadow Field" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">You cannot re-roll invulnerable saving throws made for the bearer. The first time an invulnerable saving throw made for the bearer is failed, until the end of the battle, the bearer has no invulnerable save.</characteristic></characteristics></profile><profile id="source-000003914-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Archon, Infantry, Character, Aeldari</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="source-000003914-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: splinter pistol; huskblade; shadow field.</description></rule><rule id="source-000003914-composition" name="Unit Composition" hidden="false"><description>1 Archon</description></rule><rule id="source-000003914-option-0" name="Wargear Option 1" hidden="false"><description>This model’s splinter pistol can be replaced with 1 blast pistol.</description></rule><rule id="source-000003914-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 85 pts</description></rule></rules><categoryLinks><categoryLink id="source-000003914-role" name="Character" targetId="smoke-cat-1" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000003914-model-0" name="Archon" hidden="false" type="model"><constraints><constraint id="source-000003914-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003914-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000003914-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000003914-model-0-weapon-0" name="Blast pistol" hidden="false" type="upgrade"><constraints><constraint id="source-000003914-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003914-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003914-model-0-weapon-0-profile" name="Blast pistol" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">6"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">D3</characteristic><characteristic name="Keywords" typeId="fd-rkw">pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000003914-mo