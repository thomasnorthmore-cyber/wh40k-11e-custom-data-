  <selectionEntry id="source-aeldari-000000570" name="Illic Nightspear" hidden="false" type="unit"><profiles><profile id="source-000000570-stats-0" name="Illic Nightspear" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">5+</characteristic><characteristic name="Inv" typeId="inv-11e0">5+</characteristic><characteristic name="W" typeId="w-11e0">3</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000000570-ability-4" name="Bringer of the True Death" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, each time a model in that unit makes an attack, you can re-roll the Wound roll.</characteristic></characteristics></profile><profile id="source-000000570-ability-5" name="Hunter Unseen" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">This model’s unit can only be selected as the target of a ranged attack if the attacking model is within 12".</characteristic></characteristics></profile><profile id="source-000000570-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Illic Nightspear, Infantry, Character, Epic Hero, Aeldari</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000000570-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Voidbringer; shuriken pistol; Aeldari power sword.</description></rule><rule id="source-000000570-composition" name="Unit Composition" hidden="false"><description>1 Illic Nightspear – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000000570-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 70 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000570-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000570-model-0" name="Illic Nightspear – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000000570-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000570-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000570-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000570-model-0-weapon-0" name="Shuriken pistol" hidden="false" type="upgrade"><constraints><constraint id="source-000000570-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000570-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000570-model-0-weapon-0-profile" name="Shuriken pistol" hidden="false" ty