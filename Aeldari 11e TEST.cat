.</description></rule><rule id="source-000002541-composition" name="Unit Composition" hidden="false"><description>1 Starweaver</description></rule><rule id="source-000002541-points" name="Source Points Table" hidden="false"><description>YOUR 1ST TO 3RD UNITS COST: 1 model = 70 pts; YOUR 4TH+ UNIT COSTS: 1 model = 80 pts</description></rule></rules><categoryLinks><categoryLink id="source-000002541-role" name="Dedicated Transport" targetId="smoke-cat-13" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000002541-model-0" name="Starweaver" hidden="false" type="model"><constraints><constraint id="source-000002541-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002541-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000002541-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000002541-model-0-weapon-0" name="Shuriken cannon" hidden="false" type="upgrade"><constraints><constraint id="source-000002541-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002541-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000002541-model-0-weapon-0-profile" name="Shuriken cannon" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">24"</characteristic><characteristic name="A" typeId="fd-rna">3</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">6</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw">lethal hits</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000002541-model-0-weapon-1" name="Close combat weapon" hidden="false" type="upgrade"><constraints><constraint id="source-000002541-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002541-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000002541-model-0-weapon-1-profile" name="Close combat weapon" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">4</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="80" /></costs></selectionEntry><selectionEntry id="source-aeldari-000002542" name="Yvraine" hidden="false" type="unit"><profiles><profile id="source-000002542-stats-0" name="Yvraine" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">8"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">6+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000002542-ability-3" name="Word of the Phoenix (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, in your Command phase, roll one D6: on a 2+, D3+1 destroyed Bodyguard models (excluding Support Weapon models) are returned to that unit with their full wounds remaining.</characteristic></characteristics></profile><profile id="source-000002542-ability-4" name="Herald of Ynnead" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the start of the Fight phase, select one enemy unit within Engagement Range of this model. Until the end of the phase, each time a friendly AELDARI model makes an attack that targets that unit, you can re-roll a Wound roll of 1.</characteristic></characteristics></profile><profile id="source-000002542-ability-5" name="SERVANT OF THE WHISPERING GOD" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">If your army includes YVRAINE, it cannot include any Epic Hero units (excluding Ynnari units). If your army includes any EPIC HERO units (excluding YNNARI units), it cannot include YVRAINE.</characteristic></characteristics></profile><profile id="source-000002542-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Psyker, Yvraine, Aeldari, Epic Hero, Character, Infantry</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, </characteristic></characteristics></profile></profiles><rules><rule id="source-000002542-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Storm of Whispers; Kha-vir.</description></rule><rule id="source-000002542-composition" name="Unit Composition" hidden="false"><description>1 Yvraine – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000002542-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 90 pts</description></rule></rules><categoryLinks><categoryLink id="source-000002542-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000002542-model-0" name="Yvraine – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000002542-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002542-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000002542-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000002542-model-0-weapon-0" name="Storm of Whispers" hidden="false" type="upgrade"><constraints><constraint id="source-000002542-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" share