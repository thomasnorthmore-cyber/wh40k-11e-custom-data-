scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000570-model-0-weapon-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000570-model-0-weapon-2-profile" name="Aeldari power sword" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">4</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">4</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="70" /></costs></selectionEntry><selectionEntry id="source-aeldari-000000571" name="Asurmen" hidden="false" type="unit"><profiles><profile id="source-000000571-stats-0" name="Asurmen" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">2+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">5</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000000571-ability-2" name="Tactical Acumen" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, in your Shooting phase, after that unit has shot, it can make a Normal move of up to 6". If it does, until the end of the turn, that unit is not eligible to declare a charge.</characteristic></characteristics></profile><profile id="source-000000571-ability-3" name="Hand of Asuryan" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Once per battle, when this model is selected to shoot, it can use this ability. If it does, until the end of the phase, its Bloody Twins weapon has a Damage characteristic of 3 and the [ANTI-INFANTRY 5+] and [DEVASTATING WOUNDS] abilities.</characteristic></characteristics></profile><profile id="source-000000571-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Infantry, Aspect Warrior, Asurmen, Phoenix Lord, Grenades, Epic Hero, Character, Aeldari</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000000571-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Bloody Twins; Sword of Asur.</description></rule><rule id="source-000000571-composition" name="Unit Composition" hidden="false"><description>1 Asurmen – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000000571-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 135 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000571-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000571-model-0" name="Asurmen – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000000571-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000571-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000571-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000571-model-0-weapon-0" name="Bloody Twins" hidden="false" type="upgrade"><constraints><constraint id="source-000000571-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000571-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000571-model-0-weapon-0-profile" name="Bloody Twins" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">24"</characteristic><characteristic name="A" typeId="fd-rna">6</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">5</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault, pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000000571-model-0-weapon-1" name="Sword of Asur" hidden="false" type="upgrade"><constraints><constraint id="source-000000571-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000571-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000571-model-0-weapon-1-profile" name="Sword of Asur" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">6</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">-3</characteristic><characteristic name="D" typeId="fd-md">3</characteristic><characteristic name="Keywords" typeId="fd-mkw">devastating wounds</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="135" /></costs></selectionEntry><selectionEntry id="source-aeldari-000000572" name="Jain Zar" hidden="false" type="unit"><profiles><profile id="source-000000572-stats-0" name="Jain Zar" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">8"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">2+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">5</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000000572-ability-3" name="Whirling Death" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, each time that unit Advances, do not make an Advance roll. Instead, until the end of the phase, add 6" to the Move characteristic of models in that unit and each time a model in that unit makes an Advance move, ignore any vertical distance when determining the total distance that model can be moved during that move.</characteristic></characteristics></profile><profile id="source-000000572-ability-4" name="Storm of Silence" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this model makes an attack that targets a CHARACTER unit, you can re-roll the Wound roll.</characteristic></characteristics></profile><profile id="source-000000572-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Epic Hero, Infantry, Aeldari, Aspect Warrior, Phoenix Lord, Jain Zar, Character</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000000572-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Silent Death; Blade of Destruction.</description></rule><rule id="source-000000572-composition" name="Unit Composition" hidden="false"><description>1 Jain Zar – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000000572-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 105 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000572-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000572-model-0" name="Jain Zar – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000000572-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000572-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000572-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000572-model-0-weapon-0" name="Silent Death" hidden="false" type="upgrade"><constraints><constraint id="source-000000572-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000572-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000572-model-0-weapon-0-profile" name="Silent Death" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">12"</characteristic><characteristic name="A" typeId="fd-rna">6</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">6</characteristic><characteristic name="AP" typeId="fd-rap">-2</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000000572-model-0-weapon-1" name="Blade of Destruction" hidden="false" type="upgrade"><constraints><constraint id="source-000000572-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000572-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000572-model-0-weapon-1-profile" name="Blade of Destruction" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">8</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">-3</characteristic><characteristic name="D" typeId="fd-md">2</characteristic><characteristic name="Keywords" typeId="fd-mkw">anti-infantry 3+</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="105" /></costs></selectionEntry><selectionEntry id="source-aeldari-000000573" name="Karandras" hidden="false" type="unit"><profiles><profile id="source-000000573-stats-0" name="Karandras" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">2+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">5</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000000573-ability-3" name="The Scorpion’s Bite" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Melee weapons equipped by the bearer have the [DEVASTATING WOUNDS] ability when targeting units without the TITANIC keyword.</characteristic></characteristics></profile><profile id="source-000000573-ability-4" name="Shadow Hunter" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, each time a model in that unit makes an attack, add 1 to the Hit roll.</characteristic></characteristics></profile><profile id="source-000000573-ability-5" name="Sustained Assault" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this model makes a melee attack, if it made a Charge move this turn, a successful unmodified Hit roll of 4+ scores a Critical Hit.</characteristic></characteristics></profile><profile id="source-000000573-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Epic Hero, Phoenix Lord, Aeldari, Karandras, Infantry, Character</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, </characteristic></characteristics></profile></profiles><rules><rule id="source-000000573-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Arhra’s Bane; Isirmathil; the Scorpion’s Bite.</description></rule><rule id="source-000000573-composition" name="Unit Composition" hidden="false"><description>1 Karandras – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000000573-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 90 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000573-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000573-model-0" name="Karandras – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000000573-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000573-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000573-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000573-model-0-weapon-0" name="Arhra’s Bane" hidden="false" type="upgrade"><constraints><constraint id="source-000000573-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000573-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000573-model-0-weapon-0-profile" name="Arhra’s Bane" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">12"</characteristic><characteristic name="A" typeId="fd-rna">2</chara