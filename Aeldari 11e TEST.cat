orces="false" /></constraints><profiles><profile id="source-000004196-model-1-weapon-7-profile" name="Corsair blade" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">4</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000004196-model-1-weapon-8" name="Close combat weapon" hidden="false" type="upgrade"><constraints><constraint id="source-000004196-model-1-weapon-8-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004196-model-1-weapon-8-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004196-model-1-weapon-8-profile" name="Close combat weapon" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="75" /></costs></selectionEntry><selectionEntry id="source-aeldari-000004235" name="Dragon Knights" hidden="false" type="unit"><profiles><profile id="source-000004235-stats-0" name="Dragon Knights" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">10"</characteristic><characteristic name="T" typeId="t-11e0">5</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="source-000004235-ability-1" name="On the Hunt" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When this unit is selected to make a fall-back move, that fall-back move does not prevent this unit from being eligible to shoot and eligible to declare a charge.</characteristic></characteristics></profile><profile id="source-000004235-ability-2" name="Agile Reach" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When this unit is selected to fight, melee weapons equipped by unengaged models in this unit that are within 3" of an enemy unit that is engaged with this unit can target that enemy unit.</characteristic></characteristics></profile><profile id="source-000004235-ability-3" name="Drakolithe (Once per battle, per token)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When an enemy unit ends a move within 8" of this unit, if this unit is unengaged or if that enemy unit ended that move engaged with this unit, you can use this ability. If you do, roll one D6:
- On a 3+, that enemy unit suffers 1 mortal wound.


Place one Drakolithe token next to the unit for each Drakolithe the unit is equipped with, removing one each time this ability is used.</characteristic></characteristics></profile><profile id="source-000004235-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Exodite, Mobile, Aeldari, Mounted</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000004235-starting" name="Starting Equipment" hidden="false"><description>Every model is equipped with: 1 Drakesteed Fangs and Talons; 1 Laser Lance; 1 Solar Carbine.</description></rule><rule id="source-000004235-composition" name="Unit Composition" hidden="false"><description>1 Dragon Knight Leader model; 2-5 Dragon Knights models</description></rule><rule id="source-000004235-option-0" name="Wargear Option 1" hidden="false"><description>For every 3 models in this unit, this unit can be equipped with 2 Drakolithe.</description></rule><rule id="source-000004235-points" name="Source Points Table" hidden="false"><description>YOUR 1ST TO 2ND UNITS COST: 3 models = 85 pts; YOUR 1ST TO 2ND UNITS COST: 6 models = 180 pts; YOUR 3RD+ UNIT COSTS: 3 models = 95 pts; YOUR 3RD+ UNIT COSTS: 6 models = 190 pts</description></rule></rules><categoryLinks><categoryLink id="source-000004235-role" name="Mounted" targetId="smoke-cat-3" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000004235-model-0" name="Dragon Knight Leader" hidden="false" type="model"><constraints><constraint id="source-000004235-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004235-model-0-max" type="max" field="selections" scope="parent" value="1" s