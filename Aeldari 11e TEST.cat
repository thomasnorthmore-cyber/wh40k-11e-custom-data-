<?xml version="1.0" encoding="utf-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="cat-aeldari-11e0" name="Aeldari — 11e TEST" revision="1" battleScribeVersion="2.03" gameSystemId="a78e-11e0-40k0-0001" gameSystemRevision="1" library="false">
  <selectionEntries>
    <selectionEntry id="unit-rangers-11e0" name="Rangers" hidden="false" type="unit">
      <profiles><profile id="rangers-infiltrators-11e0" name="Infiltrators" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When deploying, this unit can be set up more than 8" horizontally from enemy units and the enemy deployment zone.</characteristic></characteristics></profile><profile id="rangers-stealth-11e0" name="Stealth" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">If every model has Stealth, the unit receives the benefit of cover against ranged attacks.</characteristic></characteristics></profile><profile id="rangers-path-11e0" name="Path of the Outcast" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In the opponent’s Movement phase, after an enemy finishes a move within 8", this unit may make a Normal move of up to D6" if not engaged.</characteristic></characteristics></profile><profile id="rangers-focus-11e0" name="Battle Focus (Faction)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Aeldari faction ability. Consult the current 11e Battle Focus rules for tokens and Agile Manoeuvres; this test does not encode token management.</characteristic></characteristics></profile><profile id="rangers-keywords-profile-11e0" name="Rangers Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords">
          <characteristics>
            <characteristic name="Keywords" typeId="unit-keywords-11e0">Infantry, Aeldari, Rangers</characteristic>
            <characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic>
          </characteristics>
        </profile></profiles>
