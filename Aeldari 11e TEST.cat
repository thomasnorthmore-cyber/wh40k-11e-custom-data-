scope="parent" childId="wl-wargear-ghost" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="wl-profile-17" name="Ghostglaive – sweep" hidden="true" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">8</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">7</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">2</characteristic><characteristic name="Keywords" typeId="fd-mkw"></characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="wl-wargear-ghost" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="smoke-613-ability-rule-fated-hero" name="Fated Hero" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the start of the battle, select one of the following keywords: INFANTRY; MONSTER; MOUNTED; VEHICLE. Each time this model makes an attack that targets a unit with the selected keyword, re-roll a Hit roll of 1 and re-roll a Wound roll of 1.</characteristic></characteristics></profile><profile id="smoke-613-ability-rule-psychic-guidance" name="Psychic Guidance" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is within 12&quot; of one or more friendly Aeldari Psyker models, improve the Ballistic Skill and Weapon Skill characteristics of weapons equipped by this model by 1 and it has a Leadership characteristic of 6+.</characteristic></characteristics></profile><profile id="smoke-613-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Wraithlord, Wraith Construct, Walker, Aeldari, Monster</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="smoke-613-rule-deadly-demise-d3" name="Deadly Demise D3" hidden="false"><description>Each time this model is destroyed, after embarked units (if any) have made emergency disembark moves, roll one D6. On a 6, each unit within 6&quot; suffers D3 mortal wounds.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-613" name="Monster" targetId="smoke-cat-5" primary="true" hidden="false"/></categoryLinks><selectionEntries><selectionEntry id="smoke-613-model-0" name="Wraithlord" hidden="false" type="model"><constraints><constraint id="smoke-613-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-613-max-0" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntryGroups><selectionEntryGroup id="wl-group-wargear" name="3. Wargear" hidden="false"><constraints><constraint id="wl-wargear-minimum" type="min" value="0" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="wl-wargear-maximum" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="wl-wargear-ghost" name="Ghostglaive" hidden="false" type="upgrade"><constraints><constraint id="wl-wargear-ghost-minimum" type="m