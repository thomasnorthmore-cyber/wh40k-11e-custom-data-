</characteristic><characteristic name="Keywords" typeId="fd-rkw" /></characteristics></profile><profile id="mul-612-p-missile-1-1" name="Missile launcher – sunburst" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">48"</characteristic><characteristic name="A" typeId="fd-rna">D6</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="mul-612-mounts-bright" name="Bright lance" hidden="false" type="upgrade"><constraints><constraint id="mul-612-mounts-bright-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="mul-612-mounts-bright-max" type="max" field="selections" scope="parent" value="2" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="mul-612-p-bright-1-0" name="Bright lance" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">12</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">D6+2</characteristic><characteristic name="Keywords" typeId="fd-rkw" /></characteristics></profile></profiles></selectionEntry><selectionEntry id="mul-612-mounts-scatter" name="Scatter laser" hidden="false" type="upgrade"><constraints><constraint id="mul-612-mounts-scatter-min" type="