characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw"></characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="mul-621-secondary-star" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="smoke-621-weapon-0-2" name="Wraithbone hull" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics></profile><profile id="smoke-621-ability-rule-lanced-obliteration" name="Lanced Obliteration" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time an attack made with this model’s twin Scorpion pulsar destroys an enemy model that has the Deadly Demise ability, that model’s Deadly Demise ability inflicts mortal wounds on a D6 roll of 4+ instead of on a 6.</characteristic></characteristics></profile><profile id="smoke-621-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Vehicle, Titanic, Fly, Aeldari, Scorpion</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="smoke-621-rule-deadly-demise-d3" name="Deadly Demise D3" hidden="false"><description>Each time this model is destroyed, after embarked units (if any) have made emergency disembark moves, roll one D6. On a 6, each unit within 6&quot; suffers D3 mortal wounds.</description></rule><rule id="smoke-621-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-621" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false"/><categoryLink id="smoke-original-role-621" name="Titanic" targetId="smoke-cat-12" hidden="true"/></categoryLinks><selectionEntries><selectionEntry id="smoke-621-model-0" name="Scorpion" hidden="false" type="model"><constraints><constraint id="smoke-621-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-621-max-0" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntryGroups><selectionEntryGroup id="mul-621-secondary" name="1. Secondary Weapon" hidden="false" defaultSelectionEntryId="mul-621-secondary-shuriken"><constraints><constraint id="mul-621-secondary-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="mul-621-secondary-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false