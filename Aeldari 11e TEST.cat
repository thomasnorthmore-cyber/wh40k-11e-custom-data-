conditions></modifier></modifiers></selectionEntry><selectionEntry id="source-aeldari-000002534" name="Troupe Master" hidden="false" type="unit"><profiles><profile id="source-000002534-stats-0" name="Troupe Master" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">8"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">6+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000002534-ability-3" name="Choreographer of War" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, each time a model in that unit makes a Pile-in or Consolidation move, it can move up to 6" instead of up to 3". In addition, it does not need to end that move closer to the closest enemy model, provided it ends it as close as possible to the closest enemy unit.</characteristic></characteristics></profile><profile id="source-000002534-ability-4" name="Cegorach’s Favour" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this model makes a melee attack, you can re-roll a Hit roll of 1 and add 1 to the Wound roll.</characteristic></characteristics></profile><profile id="source-000002534-ability-5" name="TRAVELLING PLAYERS" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Unless otherwise stated, you cannot include more than one of this model in your army.</characteristic></characteristics></profile><profile id="source-000002534-ability-6" name="Flip Belt" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time the bearer’s unit makes a Normal, Advance, Fall Back or Charge move, ignore any vertical distance when determining the total distance the bearer can be moved during that move.</characteristic></characteristics></profile><profile id="source-000002534-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Character, Aeldari, Troupe Master, Infantry, Grenades</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Harlequins</characteristic></characteristics></profile></profiles><rules><rule id="source-000002534-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: shuriken pistol; Troupe Master’s blade; flip belt.</description></rule><rule id="source-000002534-composition" name="Unit Composition" hidden="false"><description>1 Troupe Master</description></rule><rule id="source-000002534-option-0" name="Wargear Option 1" hidden="false"><description>This model’s shuriken pistol can be replaced with one of the following:- 1 fusion pistol
- 1 neuro disruptor</description></rule><rule id="source-000002534-option-1" name="Wargear Option 2" hidden="false"><description>This model's Troupe Master's blade can be replaced with 1 Harlequin's special weapon.</description></rule><rule id="source-000002534-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 75 pts</description></rule></rules><categoryLinks><categoryLink id="source-000002534-role" name="Character" targetId="smoke-cat-1" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000002534-model-0" name="Troupe Master" hidden="false" type="model"><constraints><constraint id="source-000002534-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002534-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000002534-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000002534-model-0-weapon-0" name="Fusion pistol" hidden="false" type="upgrade"><constraints><constraint id="source-000002534-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002534-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000002534-model-0-weapon-0-profile" name="Fusion pistol" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">6"