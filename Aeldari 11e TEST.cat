hildForces="false" /></constraints><profiles><profile id="source-000000576-model-0-weapon-1-profile" name="Maugetar" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">5</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">2</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="100" /></costs></selectionEntry><selectionEntry id="source-aeldari-000000577" name="Autarch" hidden="false" type="unit"><profiles><profile id="source-000000577-stats-0" name="Autarch" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">3+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000000577-ability-2" name="Superlative Strategist" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, you can re-roll Advance rolls made for that unit, and you can re-roll any rolls made for that unit while it is performing an Agile Manoeuvre.</characteristic></characteristics></profile><profile id="source-000000577-ability-3" name="Path of Command" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Once per battle round, one model from your army with this ability can use it when its unit is targeted with a Stratagem. If it does, reduce the CP cost of that usage of that Stratagem by 1CP.</characteristic></characteristics></profile><profile id="source-000000577-ability-4" name="ASPECT TRAINING" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">- While this model is leading a Howling Banshees unit, it has the Fights First ability.
- While this model is leading a Striking Scorpions unit, it has the Infiltrators, Scouts 7" and Stealth abilities.</characteristic></characteristics></profile><profile id="source-000000577-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Grenades, Aeldari, Character, Infantry, Autarch</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="source-000000577-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: shuriken pistol; star glaive.</description></rule><rule id="source-000000577-composition" name="Unit Composition" hidden="false"><description>1 Autarch</description></rule><rule id="source-000000577-option-0" name="Wargear Option 1" hidden="false"><description>This model’s shuriken pistol can be replaced with one of the following:- 1 death spinner
