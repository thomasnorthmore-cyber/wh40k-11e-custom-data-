Spinner, Frame, Fly, Vehicle, Aeldari</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari, </characteristic></characteristics></profile></profiles><rules><rule id="source-000000611-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: doomweaver; twin shuriken catapult; wraithbone hull.</description></rule><rule id="source-000000611-composition" name="Unit Composition" hidden="false"><description>1 Night Spinner</description></rule><rule id="source-000000611-option-0" name="Wargear Option 1" hidden="false"><description>This model's twin shuriken catapult can be replaced with 1 shuriken cannon.</description></rule><rule id="source-000000611-points" name="Source Points Table" hidden="false"><description>YOUR 1ST TO 2ND UNITS COST: 1 model = 165 pts; YOUR 3RD+ UNIT COSTS: 1 model = 195 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000611-role" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000611-model-0" name="Night Spinner" hidden="false" type="model"><constraints><constraint id="source-000000611-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000611-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000611-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000611-model-0-weapon-0" name="Doomweaver" hidden="false" type="upgrade"><constraints><constraint id="source-000000611-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" share