>3+</characteristic><characteristic name="S" typeId="fd-rs">5</characteristic><characteristic name="AP" typeId="fd-rap">0</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw"></characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="mul-589-platform-scatter" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="mul-589-p-star-1-0" name="Starcannon" hidden="true" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36&quot;</characteristic><characteristic name="A" typeId="fd-rna">2</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw"></characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="mul-589-platform-star" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="smoke-589-weapon-0-1" name="Close combat weapon (x10)" hidden="true" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">1</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="10" field="selections" scope="parent" childId="smoke-589-model-0" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="smoke-589-weapon-1-1" name="Close combat weapon" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">1</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics></profile><profile id="smoke-589-ability-fleet-of-foot" name="Fleet of Foot" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">This unit can perform the Fade Back Agile Manoeuvre without spending a Battle Focus token to do so. It can do so even if other units have done so in the same phase, and doing so does not prevent other units from performing the same Agile Manoeuvre in the same phase.</characteristic></characteristics></profile><profile id="smoke-589-ability-rule-crewed-platform" name="Crewed Platform" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When the last Guardian Defender model in this unit is destroyed, any remaining Heavy Weapon Platform models in this unit are also destroyed.</characteristic></characteristics></profile><profile id="smoke-589-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Guardians, Battleline, Infantry, Aeldari, Grenades, Guardian Defenders</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="smoke-589-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-589" name="Battleline" targetId="smoke-cat-9" primary="true" hidden="false"/></categoryLinks><selectionEntries><selectionEntry id="smoke-589-model-0" name="Guardian Defender" hidden="false" type="model"><constraints><constraint id="smoke-589-min-0" field="selections" scope="parent" value="10" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-589-max-0" field="selections" scope="parent" value="10" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="smoke-589-equipment-0-0" name="Shuriken catapult" hidden="false" type="upgrade"><constraints><constraint id="smoke-589-equipment-0-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-589-equipment-0-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints></selectionEntry><selectionEntry id="smoke-589-equipment-0-1" name="Close combat weapon" hidden="false" type="upgrade"><constraints><constraint id="smoke-589-equipment-0-1-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-589-equipment-0-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="smoke-589-model-1" name="Heavy Weapon Platform" hidden="false" type="model"><constraints><constraint id="smoke-589-min-1" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-589-max-1" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntryGroups><selectionEntryGroup id="mul-589-platform" name="1. Heavy Weapon Platform" hidden="false" defaultSelectionEntryId="mul-589-platform-shuriken"><constraints><constraint id="mul-589-platform-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="mul-589-platform-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="mul-589-platform-shuriken" name="Shuriken cannon" hidden="false" type="upgrade"><constraints><constraint id="mul-589-platform-shuriken-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="mul-589-platform-shuriken-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints></selectionEntry><selectionEntry id="mul-589-platform-missile" name