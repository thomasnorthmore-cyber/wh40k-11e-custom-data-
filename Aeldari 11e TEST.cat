ics></profile><profile id="source-000000574-ability-3" name="Unquenchable Resolve" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">The first time this model is destroyed, at the end of the phase, roll one D6: on a 2+, set this model back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of one or more enemy units, with its full wounds remaining.</characteristic></characteristics></profile><profile id="source-000000574-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Grenades, Infantry, Character, Epic Hero, Aeldari, Aspect Warrior, Phoenix Lord, Fuegan</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000000574-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Searsong; Fire Axe.</description></rule><rule id="source-000000574-composition" name="Unit Composition" hidden="false"><description>1 Fuegan – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000000574-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 130 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000574-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000574-model-0" name="Fuegan – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000000574-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" inclu