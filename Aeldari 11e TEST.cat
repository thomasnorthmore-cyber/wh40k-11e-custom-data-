stics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="40" /></costs></selectionEntry><selectionEntry id="source-aeldari-000000587" name="Warlock Skyrunners" hidden="false" type="unit"><profiles><profile id="source-000000587-stats-0" name="Warlock Skyrunner" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">14"</characteristic><characteristic name="T" typeId="t-11e0">4</characteristic><characteristic name="Sv" typeId="sv-11e0">6+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">3</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="source-000000587-ability-2" name="Runes of Battle (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Weapons equipped by models in this unit have the [IGNORES COVER] ability.</characteristic></characteristics></profile><profile id="source-000000587-ability-3" name="Psychic Communion (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this unit is selected to shoot, for each Warlock model in this unit, until the end of the phase, add 1 to the Attacks and Strength characteristics of that model’s Destructor weapon for each other friendly Aeldari Psyker model within 6" of that model (to a maximum of +2).</characteristic></characteristics></profile><profile id="source-000000587-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Warlocks, Aeldari, Mounted, Warlock Skyrunners, Psyker, Fly</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani, </characteristic></characteristics></profile></profiles><rules><rule id="source-000000587-starting" name="Starting Equipment" hidden="false"><description>Every model is equipped with: Destructor; shuriken pistol; twin shuriken catapult; witchblade.</description></rule><rule id="source-000000587-composition" name="Unit Composition" hidden="false"><description>1-2 Warlock Skyrunners</description></rule><rule id="source-000000587-option-0" name="Wargear Option 1" hidden="false"><description>Any number of models can each have their witchblade replaced with 1 singing spear.</description></rule><rule id="source-000000587-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 45 pts; YOUR UNIT COSTS: 2 models = 90 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000587-role" name="Mounted" targetId="smoke-cat-3" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000587-model-0" name="Warlock Skyrunners" hidden="false" type="model"><constraints><constraint id="source-000000587-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000587-model-0-max" type="max" field="selections" scope="parent" value="2" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000587-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000587-model-0-weapon-0" name="Destructor" hidden="false" type="upgrade"><constraints><constraint id="source-000000587-model-0-weapon-0-min" type="min" field="selections" scope="parent" 