<selectionEntry id="fd-unit-root" name="Fire Dragons" hidden="false" type="unit">
      <profiles><profile id="fd-assured" name="Assured Destruction" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When this unit makes ranged attacks against a Monster or Vehicle, it can re-roll Hit, Wound and Damage rolls.</characteristic></characteristics></profile><profile id="fd-shrine" name="Aspect Shrine Token" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Once per battle per token, change one Hit roll or Wound roll for a non-Character model in the unit to an unmodified 6. One token per five models.</characteristic></characteristics></profile><profile id="fd-keywords-prof" name="Fire Dragons Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics>
<characteristic name="Keywords" typeId="unit-keywords-11e0">Infantry, Grenades, Fire Dragons, Aspect Warriors, Aeldari</characteristic>
<characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic>
</characteristics></profile></profiles><rules><rule id="fd-focus-rule-native" name="Battle Focus" hidden="false"><description>Asuryani army rule: Battle Focus tokens support Agile Manoeuvres. See the complete 11th-edition faction rules for token values and timing.</description></rule><rule id="fd-assault-rule-native" name="Assault" hidden="false"><description>Weapon ability (see core rules).</description></rule><rule id="fd-melta-rule-native" name="Melta" hidden="false"><description>Weapon ability (see core rules).</description></rule><rule id="fd-torrent-rule-native" name="Torrent" hidden="false"><description>Weapon ability (see core rules).</description></rule><rule id="fd-pistol-rule-native" name="Pistol" hidden="false"><description>Weapon ability (see core rules).</description></rule><rule id="fd-ignore-rule-native" name="Ignores Cover" hidden="false"><description>Weapon ability (see core rules).</description></rule></rules>
