type="max" value="2" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="wl-profile-9" name="Starcannon" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36"</characteristic><characteristic name="A" typeId="fd-rna">2</characteristic><characteristic name="BS" typeId="fd-rbs">4+</characteristic><characteristic name="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw" /></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><selectionEntries><selectionEntry id="smoke-613-equipment-0-2" name="Wraithbone fists" hidden="false" type="upgrade"><constraints><constraint id="smoke-613-equipment-0-2-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="smoke-613-equipment-0-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="smoke-613-weapon-0-2" name="Wraithbone fists" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">4</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">7</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">2</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries><costs><c