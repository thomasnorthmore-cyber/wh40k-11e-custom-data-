s" typeId="fd-rkw" /></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><selectionEntries><selectionEntry id="smoke-612-equipment-0-2" name="War Walker feet" hidden="false" type="upgrade"><constraints><constraint id="smoke-612-equipment-0-2-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="smoke-612-equipment-0-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="smoke-612-weapon-0-2" name="War Walker feet" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">5</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="80" /></costs><modifiers><modifier type="set" field="pts-11e0" value="160"><conditions><condition type="atLeast" value="2" field="selections" scope="parent" childId="smoke-612-model-0" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
<selectionEntry id="smoke-unit-589" name="Guardian Defenders" hidden="false" type="unit"><profiles><profile id="smoke-589-modelstats-0" name="Guardian Defender" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">1</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="smoke-589-modelstats-1" name="Heavy Weapon Platform" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">2</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">0</characteristic></characteristics></profile><profile id="smoke-589-ability-fleet-of-foot" name="Fleet of Foot" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">This unit can perform the Fade Back Agile Manoeuvre without spending a Battle Focus token to do so. It can do so even if other units have done so in the same phase, and doing so does not prevent other units from performing the same Agile Manoeuvre in the same phase.</characteristic></characteristics></profile><profile id="smoke-589-ability-rule-crewed-platform" name="Crewed Platform" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When the last Guardian Defender model in this unit is destroyed, any remaining Heavy Weapon Platform models in this unit are also destroyed.</characteristic></characteristics></profile><profile id="smoke-589-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Guardians, Battleline, Infantry, Aeldari, Grenades, Guardian Defenders</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="smoke-589-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-589" name="Battleline" targetId="smoke-cat-9" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="smoke-589-model-0" name="Guardian Defender" hidden="false" type="model"><constraints><constraint id="smoke-589-min-0" field="selections" scope="parent" value="10" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="smoke-589-max-0" field="selections" scope="parent" value="10" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="smoke-589-equipment-0-0" name="Shuriken catapult" hidden="false" type="upgrade"><constraints><constraint id="smoke-589-equipment-0-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" include