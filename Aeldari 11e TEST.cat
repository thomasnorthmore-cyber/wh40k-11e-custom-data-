characteristics><characteristic name="Description" typeId="description-11e0">When selecting targets for this weapon, you can measure range and determine visibility from another friendly FIRE PRISM model that is visible to the bearer. When doing so, this weapon has an Attacks characteristic of 1.</characteristic></characteristics></profile><profile id="source-000000610-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Aeldari, Fly, Frame, Vehicle, Fire Prism</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, , Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="source-000000610-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: prism cannon; twin shuriken catapult; wraithbone hull.</description></rule><rule id="source-000000610-composition" name="Unit Composition" hidden="false"><description>1 Fire Prism</description></rule><rule id="source-000000610-option-0" name="Wargear Option 1" hidden="false"><description>This model’s twin shuriken catapult can be replaced with 1 shuriken cannon.</description></rule><rule id="source-000000610-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 150 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000610-role" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000610-model-0" name="Fire Prism" hidden="false" type="model"><constraints><constraint id="source-000000610-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000610-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" incl