" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004195-model-0-weapon-2-profile" name="Wraithbone hull" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="70" /></costs><modifiers><modifier type="set" field="pts-11e0" value="140"><conditions><condition type="atLeast" value="2" field="selections" scope="parent" childId="source-000004195-model-0" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry><selectionEntry id="source-aeldari-000004196" name="Corsair Skyreavers" hidden="false" type="unit"><profiles><profile id="source-000004196-stats-0" name="Corsair Skyreavers" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">12"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">5+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">1</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000004196-ability-3" name="Raid and Run" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the end of the Fight phase, if this unit was eligible to fight this phase, and is not within Engagement Range of one or more enemy units, it can make a Normal move of up to D3+3". Otherwise, if this unit was eligible to fight this phase, this unit can make a Fall Back move of up to D3+3".</characteristic></characteristics></profile><profile id="source-000004196-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Anhrathe, Aeldari, Infantry, Grenades, Corsair Skyreavers, Fly, Jump Pack</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, , Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000004196-starting" name="Starting Equipment" hidden="false"><description>Every model is equipped with: shuriken pistol; Corsair blade.</description></rule><rule id="source-000004196-composition" name="Unit Composition" hidden="false"><description>1 Skyreaver Felarch; 4-9 Skyreavers</description></rule><rule id="source-000004196-option-0" name="Wargear Option 1" hidden="false"><description>The Skyreaver Felarch can replace its shuriken pistol with one of the following:- 1 blast pistol
- 1 neuro disruptor</description></rule><rule id="source-000004196-option-1" name="Wargear Option 2" hidden="false"><description>For every 5 models in the unit, up to 2 Skyreaver models can each have their shuriken pistol and Corsair blade replaced with one of the following*:- 1 blaster and 1 close combat weapon
- 1 flamer and 1 close combat weapon
- 1 fusion gun and 1 close combat weapon
- 1 shredder and 1 close combat weapon</description></rule><rule id="source-000004196-option-2" name="Wargear Option 3" hidden="false"><description>* You cannot select the same option more than once per unit unless it contains 10 models, in which case you cannot select the same weapon more than twice per unit.</description></rule><rule id="source-000004196-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 5 models = 75 pts; YOUR UNIT COSTS: 10 models = 140 pts</description></rule></rules><categoryLinks><categoryLink id="source-000004196-role" name="Infantry" targetId="cat-infantry-11e0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000004196-model-0" name="Skyreaver Felarch" hidden="false" type="model"><constraints><constraint id="source-000004196-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004196-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000004196-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000004196-model-0-weapon-0" name="Blaster" hidden="false" type="upgrade"><constraints><constraint id="source-000004196-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004196-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004196-model-0-weapon-0-profile" name="Blaster" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">18"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-4</characteristic><characteristic name="D" typeId="fd-rd">D6+1</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000004196-model-0-weapon-1" name="Blast pistol" hidden="false" type="upgrade"><constraints><constraint id="source-000004196-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004196-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004196-model-0-weapon-1-profile" name="Blast pistol" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">6"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">D3</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault, pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000004196-model-0-weapon-2" name="Flamer" hidden="false" type="upgrade"><constraints><constraint id="source-000004196-model-0-weapon-2-min" type="min" field="selections" scope="parent" v