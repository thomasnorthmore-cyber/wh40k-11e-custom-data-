ercentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000001393-model-0-weapon-3-profile" name="Wraithbone hull" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="115" /></costs></selectionEntry><selectionEntry id="source-aeldari-000001400" name="Bonesinger" hidden="false" type="unit"><profiles><profile id="source-000001400-stats-0" name="Bonesinger" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">6+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">3</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000001400-ability-2" name="Way of the Shaper (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, Wraith Construct models in that unit have the Feel No Pain 6+ ability.</characteristic></characteristics></profile><profile id="source-000001400-ability-3" name="Bonesinger" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is within 3" of one or more friendly Wraith Construct or Asuryani Vehicle units, unless it is leading a unit, this model has the Lone Operative ability.</characteristic></characteristics></profile><profile id="source-000001400-ability-4" name="Psytronome Shaper" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Command phase, you can select one friendly Wraith Construct or Asuryani Vehicle model within 3" of this model. That WRAITH CONSTRUCT or ASURYANI VEHICLE model regains up to D3 lost wounds.</characteristic></characteristics></profile><profile id="source-000001400-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Infantry, Character, Bonesinger, Aeldari, Psyker</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, , Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000001400-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: psytronome shaper.</description></rule><rule id="source-000001400-composition" name="Unit Composition" hidden="false"><description>1 Bonesinger</description></rule><rule id="source-000001400-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 45 pts</description></rule></rules><categoryLinks><categoryLink id="source-000001400-role" name="Character" targetId="smoke-cat-1" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000001400-model-0" name="Bonesinger" hidden="false" type="model"><constraints><constraint id="source-000001400-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000001400-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000001400-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000001400-model-0-weapon-0" name="Psytronome shaper" hidden="false" type="upgrade"><constraints><constraint id="source-000001400-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000001400-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000001400-model-0-weapon-0-profile" name="Psytronome shaper" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">2</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">D3</characteristic><characteristic name="Keywords" typeId="fd-mkw">psychic</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="45" /></costs></selectionEntry><selectionEntry id="source-aeldari-000001598" name="Amallyn Shadowguide" hidden="false" type="unit"><profiles><profile id="source-000001598-stats-0" name="Amallyn Shadowguide" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">5+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">3</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000001598-ability-4" name="The Path Least Travelled" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">If your army includes this model, after both players have deployed their armies and determined who has the first turn, you can select one Rangers or Shroud Runners unit from your army and redeploy that unit. When doing so, that unit can be placed into Strategic Reserves, regardless of how many units are already in Strategic Reserves.</characteristic></characteristics></profile><profile id="source-000001598-ability-5" name="Path of the Outcast" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your opponent's Movement phase, when an enemy unit ends a Normal, Advance or Fall Back move within 8" of this model, if this model is not within Engagement Range of one or more enemy units, it can make a Normal move of up to D6".</characteristic></characteristics></profile><profile id="source-000001598-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Grenades, Epic Hero, Aeldari, Infantry, Character, Amallyn Shadowguide</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000001598-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: ranger long rifle; power blade.</description></rule><rule id="source-000001598-composition" name="Unit Composition" hidden="false"><description>1 Amallyn Shadowguide – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000001598-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 75 pts</description></rule></rules><categoryLinks><categoryLink id="source-000001598-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000001598-model-0" name="Amallyn Shadowguide – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000001598-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000001598-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000001598-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000001598-model-0-weapon-0" name="Ranger long rifle" hidden="false" type="upgrade"><constraints><constraint id="source-000001598-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000001598-model-0-weapon-0-max" type="