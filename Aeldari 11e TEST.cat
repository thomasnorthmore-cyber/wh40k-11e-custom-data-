Units"><characteristics><characteristic name="M" typeId="m-11e0">10"</characteristic><characteristic name="T" typeId="t-11e0">5</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="source-000004237-ability-2" name="Elemental Ensnarement" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the end of your Fight phase, if this unit is not battle-shocked, you can use this ability. If you do, roll one D6:
- On a 1, this unit is battle-shocked.
- Select one visible enemy MONSTER/VEHICLE unit (excluding TITANIC units) within 18" of this unit. That enemy unit is ensnared until the start of your next turn:
- While a unit is ensnared, that unit has -2" M and cannot be pinned.</characteristic></characteristics></profile><profile id="source-000004237-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Exodite, Mobile, Psyker, Mounted, Aeldari, Character</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000004237-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: 1 Drakesteed Fangs and Talons; 1 Song of Waning; 1 Solar Carbine; 1 Stone Stave; 1 Venomcrest Spit.</description></rule><rule id="source-000004237-composition" name="Unit Composition" hidden="false"><description>1 Stonesinger model</description></rule><rule id="source-000004237-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 55 pts</description></rule></rules><categoryLinks><categoryLink id="source-000004237-role" name="Mounted Character" targetId="smoke-cat-2" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000004237-model-0" name="Stonesinger" hidden="false" type="model"><constraints><constraint id="source-000004237-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004237-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000004237-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000004237-model-0-weapon-0" name="Song of Waning" hidden="false