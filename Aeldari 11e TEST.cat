        <profile id="rangers-infiltrators-11e0" name="Infiltrators" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When deploying, this unit can be set up more than 8" horizontally from enemy units and the enemy deployment zone.</characteristic></characteristics></profile>
