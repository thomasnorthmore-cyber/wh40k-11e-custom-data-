rofiles><rules><rule id="source-000003920-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: dark lance; bladevanes.</description></rule><rule id="source-000003920-composition" name="Unit Composition" hidden="false"><description>1 Raider</description></rule><rule id="source-000003920-option-0" name="Wargear Option 1" hidden="false"><description>This model’s dark lance can be replaced with 1 disintegrator cannon.</description></rule><rule id="source-000003920-points" name="Source Points Table" hidden="false"><description>YOUR 1ST TO 3RD UNITS COST: 1 model = 70 pts; YOUR 4TH+ UNIT COSTS: 1 model = 80 pts</description></rule></rules><categoryLinks><categoryLink id="source-000003920-role" name="Dedicated Transport" targetId="smoke-cat-13" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000003920-model-0" name="Raider" hidden="false" type="model"><constraints><constraint id="source-000003920-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003920-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000003920-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000003920-model-0-weapon-0" name="Dark lance" hidden="false" type="upgrade"><constraints><constraint id="source-000003920-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003920-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="fa