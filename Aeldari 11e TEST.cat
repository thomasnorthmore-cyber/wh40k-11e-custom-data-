me="S" typeId="fd-rs">8</characteristic><characteristic name="AP" typeId="fd-rap">-3</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw"></characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="falcon-turret-star" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="falcon-profile-6" name="Twin shuriken catapult" hidden="true" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">18&quot;</characteristic><characteristic name="A" typeId="fd-rna">2</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">Assault, Twin-linked</characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="falcon-underside-twin" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="falcon-profile-7" name="Shuriken cannon" hidden="true" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">24&quot;</characteristic><characteristic name="A" typeId="fd-rna">3</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">6</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw">Lethal Hits</characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="falcon-underside-shuriken" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="smoke-609-weapon-0-3" name="Wraithbone hull" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics></profile><profile id="smoke-609-ability-rule-fire-support" name="Fire Support" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Shooting phase, after this model has shot, select one enemy unit hit by one or more of those attacks. Until the end of the turn, each time a friendly model that disembarked from this TRANSPORT this turn makes an attack that targets that enemy unit, you can re-roll the Wound roll.</characteristic></characteristics></profile><profile id="smoke-609-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Aeldari, Falcon, Frame, Fly, Transport, Vehicle</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="smoke-609-rule-deadly-demise-d3" name="Deadly Demise D3" hidden="false"><description>Each time this model is destroyed, after embarked units (if any) have made emergency disembark moves, roll one D6. On a 6, each unit within 6&quot; suffers D3 mortal wounds.</description></rule><rule id="smoke-609-rule-deep-strike" name="Deep Strike" hidden="false"><description>Each time this unit makes an ingress move, if every model in this unit has Deep Strike, it can be set up more than 8&quot; horizontally from all enemy units, including within the opponent’s deployment zone.</description></rule><rule id="smoke-609-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-609" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false"/><categoryLink id="smoke-original-role-609" name="Transport" targetId="smoke-cat-7" hidden="true"/></categoryLinks><selectionEntries><selectionEntry id="smoke-609-model-0" name="Falcon" hidden="false" type="model"><constraints><constraint id="smoke-609-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-609-max-0" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntryGroups><selectionEntryGroup id="falcon-group-turret" name="1. Turret weapon (choose one)" hidden="false" defaultSelectionEntryId="falcon-turret-scatter"><constraints><constraint id="falcon-turret-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="falcon-turret-max" type="max" field="selections" s