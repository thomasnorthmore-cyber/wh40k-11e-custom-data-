ludes THE VISARCH, it cannot include any Epic Hero units (excluding Ynnari units). If your army includes any EPIC HERO units (excluding YNNARI units), it cannot include THE VISARCH.</characteristic></characteristics></profile><profile id="source-000002543-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Infantry, Aeldari, The Visarch, Character, Epic Hero</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, </characteristic></characteristics></profile></profiles><rules><rule id="source-000002543-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Asu-var.</description></rule><rule id="source-000002543-composition" name="Unit Composition" hidden="false"><description>1 Visarch – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000002543-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 80 pts</description></rule></rules><categoryLinks><categoryLink id="source-000002543-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000002543-model-0" name="Visarch – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000002543-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002543-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000002543-model-0-equipment" name