<selectionEntry id="smoke-unit-603" name="Crimson Hunter" hidden="false" type="unit"><profiles><profile id="smoke-603-modelstats-0" name="Crimson Hunter" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">-</characteristic><characteristic name="T" typeId="t-11e0">8</characteristic><characteristic name="Sv" typeId="sv-11e0">3+</characteristic><characteristic name="Inv" typeId="inv-11e0">5+</characteristic><characteristic name="W" typeId="w-11e0">12</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">-</characteristic></characteristics></profile><profile id="smoke-603-ability-603-rule-skyhunter" name="Skyhunter" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this model makes a ranged attack that targets a unit that can FLY, add 1 to the Hit roll and add 1 to the Wound roll.</characteristic></characteristics></profile><profile id="smoke-603-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Aircraft, Fly, Aeldari, Vehicle, Crimson Hunter, Aspect Warrior</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules /><categoryLinks><categoryLink id="smoke-category-603" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false" /><categoryLink id="smoke-original-role-603" name="Aircraft" targetId="smoke-cat-10" hidden="true" /></categoryLinks><selectionEntries><selectionEntry id="smoke-603-model-0" name="Crimson Hunter" hidden="false" type="model"><constraints><constraint id="smoke-603-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces=