<selectionEntry id="smoke-unit-599" name="Wave Serpent" hidden="false" type="unit"><profiles><profile id="smoke-599-modelstats-0" name="Wave Serpent" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">14"</characteristic><characteristic name="T" typeId="t-11e0">9</characteristic><characteristic name="Sv" typeId="sv-11e0">3+</characteristic><characteristic name="Inv" typeId="inv-11e0">5+</characteristic><characteristic name="W" typeId="w-11e0">13</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="smoke-599-ability-wave-serpent-shield" name="Wave Serpent Shield" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time a ranged attack targets this model, if the Strength characteristic of that attack is greater than the Toughness characteristic of this model, subtract 1 from the Wound roll.</characteristic></characteristics></profile><profile id="smoke-599-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Wave Serpent, Frame, Vehicle, Aeldari, Transport, Dedicated Transport, Fly</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="smoke-599-rule-deadly-demise-d3" name="Deadly Demise D3" hidden="false"><description>Each time this model is destroyed, after embarked units (if any) have made emergency disembark moves, roll one D6. On a 6, each unit within 6" suffers D3 mortal wounds.</description></rule><rule id="smoke-599-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-599" name="Dedicated Transport" targetId="smoke-cat-13" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="smoke-599-model-0" name="Wave Serpent" hidden="false" type="model"><constraints><constraint id="smoke-599-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="smoke-599-max-0" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="mul-599-turret" name="Twin Turret Weapon" hidden="false" defaultSelectionEntryId="mul-599-turret-twin-shuriken"><constraints><constraint id="mul-599-turret-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="mul-599-turret-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="mul-599-turret-twin-shuriken" name="Twin shuriken cannon" hidden="false" type="upgrade"><constraints><constraint id="mul-599-turret-twin-shuriken-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="mul-599-turret-twin-shuriken-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeCh