ic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="source-000000618-ability-2" name="Lightning Assault" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this model ends a Normal move, you can select one enemy unit (excluding MONSTER and VEHICLE units) that it moved over during that move, then roll six D6: for each 4+, that enemy unit suffers 1 mortal wound.</characteristic></characteristics></profile><profile id="source-000000618-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Vehicle, Fly, Aeldari, Hornet</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani, </characteristic></characteristics></profile></profiles><rules><rule id="source-000000618-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: 2 Hornet pulse lasers; wraithbone hull.</description></rule><rule id="source-000000618-composition" name="Unit Composition" hidden="false"><description>1 Hornet</description></rule><rule id="source-000000618-option-0" name="Wargear Option 1" hidden="false"><description>Each of this model’s Hornet pulse lasers can be replaced with one of the following:- Aeldari missile launcher
- Bright lance
