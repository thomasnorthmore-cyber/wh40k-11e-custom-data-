        <profile id="fd-assured" name="Assured Destruction" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">When this unit makes ranged attacks against a Monster or Vehicle, it can re-roll Hit, Wound and Damage rolls.</characteristic></characteristics></profile>
        <profile id="fd-shrine" name="Aspect Shrine Token" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Once per battle per token, change one Hit roll or Wound roll for a non-Character model in the unit to an unmodified 6. One token per five models.</characteristic></characteristics></profile>
