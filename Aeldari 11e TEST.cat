racteristic><characteristic name="S" typeId="fd-ms">5</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="2" field="selections" scope="parent" childId="smoke-612-model-0" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></profile><profile id="smoke-612-ability-rule-crystalline-targeting" name="Crystalline Targeting" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Shooting phase, after this unit has shot, select one enemy unit hit by one or more of those attacks. Until the end of the phase, each time a friendly AELDARI unit makes an attack that targets that enemy unit, improve the Armour Penetration characteristic of that attack by 1. Each unit can only be selected for this ability once per turn.</characteristic></characteristics></profile><profile id="smoke-612-ability-scouts-9-" name="Scouts 9&quot;" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In the Resolve Pre-battle Abilities step, this unit may make a Scout move of 9&quot; when eligible. See the full Scouts core rule for transport and Strategic Reserve interactions.</characteristic></characteristics></profile><profile id="smoke-612-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Vehicle, War Walkers, Walker, Aeldari</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="smoke-612-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-612" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false"/><categoryLink id="smoke-original-role-612" name="Walker" targetId="smoke-cat-8" hidden="true"/></categoryLinks><selectionEntries><selectionEntry id="smoke-612-model-0" name="War Walker" hidden="false" type="model"><constraints><constraint id="smoke-612-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-612-max-0" field="selections" scope="parent" value="2" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntryGroups><selectionEntryGroup id="mul-612-mounts" name="1. Heavy Weapon Mounts" hidden="false" defaultSelectionEntryId="mul-612-mounts-shuriken"><constraints><constraint id="mul-612-mounts-min" type="min" field="selections" scope="parent" value="2" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="mul-612-mounts-max" type="max" field="selections" scope="parent" value="2" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="mul-612-mounts-shuriken" name="Shuriken cannon" hidden="false" type="upgrade"><constraints><constraint id="mul-612-mounts-shuriken-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="mul-612-mo