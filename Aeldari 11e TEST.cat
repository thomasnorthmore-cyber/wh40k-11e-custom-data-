ary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000002533-model-0" name="Shroud Runners" hidden="false" type="model"><constraints><constraint id="source-000002533-model-0-min" type="min" field="selections" scope="parent" value="3" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002533-model-0-max" type="max" field="selections" scope="parent" value="6" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000002533-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000002533-model-0-weapon-0" name="Long rifle" hidden="false" type="upgrade"><constraints><constraint id="source-000002533-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000002533-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000002533-model-0-weapon-0-profile" name="Long rifle" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw">precision</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000002533-model-0-we