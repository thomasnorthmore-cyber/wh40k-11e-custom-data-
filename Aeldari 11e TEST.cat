me="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw" /></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><selectionEntryGroups /><selectionEntries><selectionEntry id="smoke-605-equipment-0-2" name="Wraithbone hull" hidden="false" type="upgrade"><constraints><constraint id="smoke-605-equipment-0-2-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="smoke-605-equipment-0-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="smoke-605-weapon-0-2" name="Wraithbone hull" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="75" /></costs><modifiers><modifier type="set" field="pts-11e0" value="140"><conditions><condition type="atLeast" value="2" field="selections" scope="parent" childId="smoke-605-model-0" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
<selectionEntry id="smoke-unit-609" name="Falcon" hidden="false" type="unit"><profiles><profile id="smoke-609-modelstats-0" name="Falcon" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">14"</characteristic><characteristic name="T" typeId="t-11e0">9</characteristic><characteristic name="Sv" typeId="sv-11e0">3+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">12</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">3</characteristic></characteristics></profile><profile id="smoke-609-ability-rule-fire-support" name="Fire Support" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Shooting phase, after this model has shot, select one enemy unit hit by one or more of those attacks. Until the end of the turn, each time a friendly model that disembarked from this TRANSPORT this turn makes an attack that targets that enemy unit, you can re-roll the Wound roll.</characteristic></characteristics></profile><profile id="smoke-609-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Aeldari, Falcon, Frame, Fly, Transport, Vehicle</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="smoke-609-rule-deadly-demise-d3" name="Deadly Demise D3" hidden="false"><description>Each time this model is destroyed, after embarked units (if any) have made emergency disembark moves, roll one D6. On a 6, each unit within 6" suffers D3 mortal wounds.</description></rule><rule id="smoke-609-rule-deep-strike" name="Deep Strike" hidden="false"><description>Each time this unit makes an ingress move, if every model in this unit has Deep Strike, it can be set up more than 8" horizontally from all enemy units, including within the opponent’s deployment zone.</description></rule><rule id="smoke-609-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-609" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false" /><categoryLink id="smoke-original-role-609" name="Transport" targetId="smoke-cat-7" hidden="true" /></categoryLinks><selectionEntries><selectionEntry id="smoke-609-model-0" name="Falcon" hidden="false" type="model"><constraints><constraint id="smoke-609-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="smoke-609-max-0" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="falcon-group-turret" name="Turret weapon (choose one)" hidden="false" defaultSelectionEntryId="falcon-turret-scatter"><constraints><constraint id="falcon-turret-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="falcon-turret-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="falcon-turret-scatter" name="Scatter laser" hidden="false" type="upgrade"><profiles><profile id="falcon-profile-0" name="Scatter laser" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36"</characteristic><characteristic name="A" typeId="fd-rna">6</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">5</characteristic><characteristic name="AP" typeId="fd-rap">0</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="falcon-turret-missile" name="Missile launcher" hidden="false" type="upgrade"><profiles><profile id="falcon-profile-1" name="Missile launcher – starshot" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">48"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">10</characteristic><characteristic name="AP" typeId="fd-rap">-2</characteristic><characteristic name="D" typeId="fd-rd">D6</characteristic><characteristic name="Keywords" typeId="fd-rkw" /></characteristics></profile><profile id="falcon-profile-2" name="Missile launcher – sunburst" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">48"</characteristic><characteristic name="A" typeId="fd-rna">D6</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">Blast</characteristic></characteristics></profile></profiles><