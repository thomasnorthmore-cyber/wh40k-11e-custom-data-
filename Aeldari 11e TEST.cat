<selectionEntry id="smoke-unit-581" name="Avatar of Khaine [CATEGORY TEST]" hidden="false" type="unit"><profiles><profile id="smoke-581-modelstats-0" name="Avatar of Khaine" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">10&quot;</characteristic><characteristic name="T" typeId="t-11e0">11</characteristic><characteristic name="Sv" typeId="sv-11e0">2+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">14</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">5</characteristic></characteristics></profile><profile id="smoke-581-weapon-0-0" name="The Wailing Doom" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">12&quot;</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">16</characteristic><characteristic name="AP" typeId="fd-rap">-4</characteristic><characteristic name="D" typeId="fd-rd">D6+2</characteristic></characteristics></profile><profile id="smoke-581-weapon-0-1" name="The Wailing Doom – strike" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">6</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">16</characteristic><characteristic name="AP" typeId="fd-map">-4</characteristic><characteristic name="D" typeId="fd-md">D6+2</characteristic></characteristics></profile><profile id="smoke-581-weapon-0-2" name="The Wailing Doom – sweep" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">12</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">8</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">2</characteristic></characteristics></profile><profile id="smoke-581-ability-rule-molten-form" name="Molten Form" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time an attack is allocated to this model, halve the Damage characteristic of that attack.</characteristic></characteristics></profile><profile id="smoke-581-ability-handed-aura-" name="The Bloody-Handed (Aura)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While a friendly AELDARI unit is within 6&quot; of this model, add 1 to Advance and Charge rolls made for that unit.</characteristic></characteristics></profile><profile id="smoke-581-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Avatar of Khaine, Character, Epic Hero, Aeldari, Monster, Daemon</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="smoke-581-rule-deadly-demise-d3" name="Deadly Demise D3" hidden="false"><description>Each time this model is destroyed, after embarked units (if any) have made emergency disembark moves, roll one D6. On a 6, each unit within 6&quot; suffers D3 mortal wounds.</description></rule><rule id="smoke-581-rule-battle-focus-faction-" name="Battle Focus (Faction)" hidden="false"><description>If your Army Faction is Asuryani, at the start of each battle round you receive Battle Focus tokens: Incursion 2, Strike Force 4, Onslaught 6. Spend tokens to enable eligible Agile Manoeuvres; unused tokens expire at the end of the battle round. Consult the full faction rule for manoeuvre triggers and effects.</description></rule></rules><categoryLinks><categoryLink id="smoke-category-581" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false"/><categoryLink id="smoke-original-role-581" name="Monster Epic Hero" targetId="smoke-cat-4" hidden="true"/></categoryLinks><selectionEntries><selectionEntry id="smoke-581-model-0" name="Avatar of Khaine" hidden="false" type="model"><constraints><constraint id="smoke-581-min-0" field="selections" scope="parent" value="1" type="min" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-581-max-0" field="selections" scope="parent" value="1" type="max" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="smoke-581-equipment-0-0" name="The Wailing Doom" hidden="false" type="upgrade"><constraints><constraint id="smoke-581-equipment-0-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-581-equipment-0-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></constraints></selectionEntry><selectionEntry id="smoke-581-equipment-0-1" name="The Wailing Doom – strike" hidden="false" type="upgrade"><constraints><constraint id="smoke-581-equipment-0-1-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/><constraint id="smoke-581-equipment-0-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/></const