id="source-000003921-ability-6" name="Lithe Embarkation" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the end of the Fight phase, if there are no models currently embarked within this TRANSPORT, you can select one friendly Ynnari Infantry unit that only includes models from the units listed in this unit’s Transport section, that has 6 or fewer models and that is wholly within 6" of this TRANSPORT. Unless that unit is within Engagement Range of one or more enemy units, it can embark within this TRANSPORT. That unit can embark within this TRANSPORT in a turn it disembarked from this TRANSPORT.</characteristic></characteristics></profile><profile id="source-000003921-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Transport, Venom, Frame, Fly, Dedicated Transport, Vehicle, Aeldari</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="source-000003921-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: splinter cannon; twin splinter rifle; bladevanes.</description></rule><rule id="source-000003921-composition" name="Unit Composition" hidden="false"><description>1 Venom</description></rule><rule id="source-000003921-option-0" name="Wargear Option 1" hidden="false"><description>This model’s twin splinter rifle can be replaced with 1 splinter cannon.</description></rule><rule id="source-000003921-points" name="Source Points Table" hidden="false"><description>YOUR 1ST TO 3RD UNITS COST: 1 model = 65 pts; YOUR 4TH+ UNIT COSTS: 1 model = 75 pts</description></rule></rules><categoryLinks><categoryLink id="source-000003921-role" name="Dedicated Transport" targetId="smoke-cat-13" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000003921-model-0" name="Venom" hidden="false" type="model"><constraints><constraint id="source-000003921-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003921-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000003921-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000003921-model-0-weapon-0" name="Splinter cannon" hidden="false" type="upgrade"><constraints><constraint id="source-000003921-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003921-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003921-model-0-weapon-0-profile" name="Splinter cannon" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36"</characteristic><characteristic name="A" typeId="fd-rna">3</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">3</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw">anti-infantry 3+, sustained hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000003921-model-0-weapon-1" name="Twin splinter rifle" hidden="false" type="upgrade"><constraints><constraint id="source-000003921-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003921-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003921-model-0-weapon-1-profile" name="Twin splinter rifle" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">24"</characteristic><characteristic name="A" typeId="fd-rna">2</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">2</characteristic><characteristic name="AP" typeId="fd-rap">0</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">anti-infantry 3+, assault, rapid fire 1, twin-linked</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000003921-model-0-weapon-2" name="Bladevanes" hidden="false" type="upgrade"><constraints><constraint id="source-000003921-model-0-weapon-2-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003921-model-0-weapon-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003921-model-0-weapon-2-profile" name="Bladevanes" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">4+</characteristic><characteristic name="S" typeId="fd-ms">5</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="75" /></costs></selectionEntry><selectionEntry id="source-aeldari-000004193" name="Prince Yriel" hidden="false" type="unit"><profiles><profile id="source-000004193-stats-0" name="Prince Yriel" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">3+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">5</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000004193-ability-3" name="Piratical Hero" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">While this model is leading a unit, each time a model in that unit makes an attack, that attack has the [SUSTAINED HITS 1] ability and add 1 to the Hit roll.</characteristic></characteristics></profile><profile id="source-000004193-ability-4" name="Prince of Corsairs" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">After both players have deployed their armies, if this unit is on the battlefield (or any Transport it is embarked within is on the battlefield), select up to three AELDARI units from your army and redeploy them. When doing so, you can set those units up in Strategic Reserves, regardless of how many units are already in Strategic Reserves.</characteristic></characteristics></profile><profile id="source-000004193-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Anhrathe, Prince Yriel, Infantry, Aeldari, Character, Epic Hero</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Asuryani, </characteristic></characteristics></profile></profiles><rules><rule id="source-000004193-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Eye of Wrath; shuriken pistol; Spear of Twilight.</description></rule><rule id="source-000004193-composition" name="Unit Composition" hidden="false"><description>1 Prince Yriel – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000004193-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 95 pts</description></rule></rules><categoryLinks><categoryLink id="source-000004193-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000004193-model-0" name="Prince Yriel – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000004193-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004193-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000004193-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000004193-model-0-weapon-0" name="Eye of Wrath" hidden="false" type="upgrade"><constraints><constraint id="source-000004193-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004193-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004193-model-0-weapon-0-profile" name="Eye of Wrath" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">6"</characteristic><characteristic name="A" typeId="fd-rna">3</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">6</characteristic><characteristic name="AP" typeId="fd-rap">-2</characteristic><characteristic name="D" typeId="fd-rd">2</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault, pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000004193-model-0-weapon-1" name="Shuriken pistol" hidden="false" type="upgrade"><constraints><constraint id="source-000004193-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004193-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004193-model-0-weapon-1-profile" name="Shuriken pistol" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">12"</characteristic><characteristic name="A" typeId="fd-rna">1</characteristic><characteristic name="BS" typeId="fd-rbs">2+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault, pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000004193-model-0-weapon-2" name="Spear of Twilight" hidden="false" type="upgrade"><constraints><constraint id="source-000004193-model-0-weapon-2-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004193-model-0-weapon-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004193-model-0-weapon-2-profile" name="Spear of Twilight" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">5</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">7</characteristic><characteristic name="AP" typeId="fd-map">-3</characteristic><characteristic name="D" typeId="fd-md">3</characteristic><characteristic name="Keywords" typeId="fd-mkw">lance</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="95" /></costs></selectionEntry><selectionEntry id="source-aeldari-000004194" name="Kharseth" hidden="false" type="unit"><profiles><profile id="source-000004194-stats-0" name="Prince Yriel" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">3</characteristic><characteristic name="Sv" typeId="sv-11e0">6+</characteristic><characteristic name="Inv" typeId="inv-11e0">4+</characteristic><characteristic name="W" typeId="w-11e0">4</characteristic><characteristic name="Ld" typeId="ld-11e0">6+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000004194-ability-3" name="Aethersense (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Enemy units that are set up on the battlefield from Reserves cannot be set up within 12" of this model.</characteristic></characteristics></profile><profile id="source-000004194-ability-4" name="Fury of the Void (Psychic)" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Shooting phase, after this model’s unit has shot, select one enemy unit hit by one or more attacks made with this model’s Dread of the Deep Void. Until the end of the turn, that unit is riven. Each time an AELDARI model from your army makes an attack that targets a riven unit, add 1 to the Strength characteristic of that attack.</characteristic></characteristics></profile><profile id="source-000004194-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Kharseth, Character, Anhrathe, Psyker, Epic Hero, Aeldari, Infantry</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000004194-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: Dread of the Deep Void; Waystave.</description></rule><rule id="source-000004194-composition" name="Unit Composition" hidden="false"><description>1 Kharseth – &lt;span class="kwb"&gt;EPIC&lt;/span&gt; &lt;span class="kwb"&gt;HERO&lt;/span&gt;</description></rule><rule id="source-000004194-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 80 pts</description></rule></rules><categoryLinks><categoryLink id="source-000004194-role" name="Epic Hero" targetId="smoke-cat-0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000004194-model-0" name="Kharseth – &lt;span class=&quot;kwb&quot;&gt;EPIC&lt;/span&gt; &lt;span class=&quot;kwb&quot;&gt;HERO&lt;/span&gt;" hidden="false" type="model"><constraints><constraint id="source-000004194-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004194-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000004194-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000004194-model-0-weapon-0" name="Dread of the Deep Void" hidden="false" type="upgrade"><constraints><constraint id="source-000004194-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004194-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004194-model-0-weapon-0-profile" name="Dread of the Deep Void" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">24"</characteristic><characteristic name="A" typeId="fd-rna">D6+2</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">3</characteristic><characteristic name="AP" typeId="fd-rap">-2</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">anti-infantry 2+, blast, hazardous, ignores cover, psychic</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000004194-model-0-weapon-1" name="Waystave" hidden="false" type="upgrade"><constraints><constraint id="source-000004194-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004194-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004194-model-0-weapon-1-profile" name="Waystave" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">3</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">3</characteristic><characteristic name="Keywords" typeId="fd-mkw">anti-infantry 2+, psychic</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="80" /></costs></selectionEntry><selectionEntry id="source-aeldari-000004195" name="Starfangs" hidden="false" type="unit"><profiles><profile id="source-000004195-stats-0" name="Starfangs" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">14"</characteristic><characteristic name="T" typeId="t-11e0">6</characteristic><characteristic name="Sv" typeId="sv-11e0">3+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">6</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">2</characteristic></characteristics></profile><profile id="source-000004195-ability-3" name="Hallucinogen Grenades" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the start of your opponent’s Shooting phase, this unit can use this ability. If it does, select one Aeldari Infantry unit from your army visible to and within 36" of this unit: until the end of the phase, that unit has the Stealth ability.</characteristic></characteristics></profile><profile id="source-000004195-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Starfangs, Grenades, Smoke, Fly, Anhrathe, Aeldari, Vehicle</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, , Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000004195-starting" name="Starting Equipment" hidden="false"><description>Every model is equipped with: disintegrator cannon; Starfang grenade launcher; wraithbone hull.</description></rule><rule id="source-000004195-composition" name="Unit Composition" hidden="false"><description>1-2 Starfangs</description></rule><rule id="source-000004195-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 70 pts; YOUR UNIT COSTS: 2 models = 140 pts</description></rule></rules><categoryLinks><categoryLink id="source-000004195-role" name="Vehicle" targetId="smoke-cat-6" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000004195-model-0" name="Starfangs" hidden="false" type="model"><constraints><constraint id="source-000004195-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004195-model-0-max" type="max" field="selections" scope="parent" value="2" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000004195-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000004195-model-0-weapon-0" name="Disintegrator cannon" hidden="false" type="upgrade"><constraints><constraint id="source-000004195-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000004195-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000004195-model-0-weapon-0-profile" name="Disintegrator cannon" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">36"</characteristic><characteristic name="A" typeId="fd-rna">3</characteristic><characte