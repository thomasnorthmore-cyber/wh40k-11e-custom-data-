ypeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">extra attacks, lethal hits</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000003909-model-0-weapon-2" name="Weaverender" hidden="false" type="upgrade"><constraints><constraint id="source-000003909-model-0-weapon-2-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003909-model-0-weapon-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003909-model-0-weapon-2-profile" name="Weaverender" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">5</characteristic><characteristic name="WS" typeId="fd-mws">2+</characteristic><characteristic name="S" typeId="fd-ms">6</characteristic><characteristic name="AP" typeId="fd-map">-2</characteristic><characteristic name="D" typeId="fd-md">2</characteristic><characteristic name="Keywords" typeId="fd-mkw">lethal hits</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="135" /></costs></selectionEntry><selectionEntry id="source-aeldari-000003910" name="D-cannon Platform" hidden="false" type="unit"><profiles><profile id="source-000003910-stats-0" name="D-Cannon Platform" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">6</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">5</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000003910-ability-0" name="Support Weapon" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time an attack targets this model’s unit, if that unit contains one or more other models, until that attack is resolved, this model has a Toughness characteristic of 3.</characteristic></characteristics></profile><profile id="source-000003910-ability-1" name="Structural Collapse" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time this model makes an attack with its D-cannon, re-roll a Damage roll of 1. If that attack targets a TITANIC unit, you can re-roll the Damage roll instead.</characteristic></characteristics></profile><profile id="source-000003910-ability-2" name="SUPPORT ARTILLERY" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the start of the Declare Battle Formations step, this model can join one Guardian Defenders unit from your army (a unit cannot have more than one Support Weapon model joined to it). This model then counts as part of that GUARDIANS unit for the rest of the battle, and that unit’s Starting Strength is increased accordingly.

This model, and any unit it is joined to, cannot embark within a Transport.</characteristic></characteristics></profile><profile id="source-000003910-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">D-cannon Platform, Support Weapon, Frame, Aeldari, Infantry</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">, Asuryani, Ynnari</characteristic></characteristics></profile></profiles><rules><rule id="source-000003910-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: D-cannon; shuriken catapult; close combat weapon.</description></rule><rule id="source-000003910-composition" name="Unit Composition" hidden="false"><description>1 D-cannon Platform</description></rule><rule id="source-000003910-points" name="Source Points Table" hidden="false"><description>YOUR 1ST TO 2ND UNITS COST: 1 model = 110 pts; YOUR 3RD+ UNIT COSTS: 1 model = 130 pts</description></rule></rules><categoryLinks><categoryLink id="source-000003910-role" name="Infantry" targetId="cat-infantry-11e0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000003910-model-0" name="D-cannon Platform" hidden="false" type="model"><constraints><constraint id="source-000003910-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003910-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000003910-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000003910-model-0-weapon-0" name="D-cannon" hidden="false" type="upgrade"><constraints><constraint id="source-000003910-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003910-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003910-model-0-weapon-0-profile" name="D-cannon" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">24"</characteristic><characteristic name="A" typeId="fd-rna">D3</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">16</characteristic><characteristic name="AP" typeId="fd-rap">-4</characteristic><characteristic name="D" typeId="fd-rd">D6+2</characteristic><characteristic name="Keywords" typeId="fd-rkw">blast, devastating wounds, indirect fire</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000003910-model-0-weapon-1" name="Shuriken catapult" hidden="false" type="upgrade"><constraints><constraint id="source-000003910-model-0-weapon-1-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003910-model-0-weapon-1-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003910-model-0-weapon-1-profile" name="Shuriken catapult" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">18"</characteristic><characteristic name="A" typeId="fd-rna">2</characteristic><characteristic name="BS" typeId="fd-rbs">3+</characteristic><characteristic name="S" typeId="fd-rs">4</characteristic><characteristic name="AP" typeId="fd-rap">-1</characteristic><characteristic name="D" typeId="fd-rd">1</characteristic><characteristic name="Keywords" typeId="fd-rkw">assault</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="source-000003910-model-0-weapon-2" name="Close combat weapon" hidden="false" type="upgrade"><constraints><constraint id="source-000003910-model-0-weapon-2-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003910-model-0-weapon-2-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000003910-model-0-weapon-2-profile" name="Close combat weapon" hidden="false" typeId="fd-melee-type" typeName="Melee Weapons"><characteristics><characteristic name="Range" typeId="fd-mrng">Melee</characteristic><characteristic name="A" typeId="fd-ma">2</characteristic><characteristic name="WS" typeId="fd-mws">3+</characteristic><characteristic name="S" typeId="fd-ms">3</characteristic><characteristic name="AP" typeId="fd-map">0</characteristic><characteristic name="D" typeId="fd-md">1</characteristic><characteristic name="Keywords" typeId="fd-mkw">-</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries><costs><cost name="pts" typeId="pts-11e0" value="110" /></costs></selectionEntry><selectionEntry id="source-aeldari-000003911" name="Shadow Weaver Platform" hidden="false" type="unit"><profiles><profile id="source-000003911-stats-0" name="Shadow Weaver Platform" hidden="false" typeId="stat-11e0" typeName="Units"><characteristics><characteristic name="M" typeId="m-11e0">7"</characteristic><characteristic name="T" typeId="t-11e0">6</characteristic><characteristic name="Sv" typeId="sv-11e0">4+</characteristic><characteristic name="Inv" typeId="inv-11e0">-</characteristic><characteristic name="W" typeId="w-11e0">5</characteristic><characteristic name="Ld" typeId="ld-11e0">7+</characteristic><characteristic name="OC" typeId="oc-11e0">1</characteristic></characteristics></profile><profile id="source-000003911-ability-0" name="Support Weapon" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">Each time an attack targets this model’s unit, if that unit contains one or more other models, until that attack is resolved, this model has a Toughness characteristic of 3.</characteristic></characteristics></profile><profile id="source-000003911-ability-1" name="Monofilament Snare" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">In your Shooting phase, after this model has shot, select one enemy unit hit by one or more of those attacks made with its shadow weaver. Until the start of your next turn, that enemy unit is snared. While a unit is snared, each time that unit makes a Normal, Advance or Fall Back move, roll one D6 for each model in that unit: for each 1, that unit suffers 1 mortal wound.</characteristic></characteristics></profile><profile id="source-000003911-ability-2" name="SUPPORT ARTILLERY" hidden="false" typeId="ability-11e0" typeName="Abilities"><characteristics><characteristic name="Description" typeId="description-11e0">At the start of the Declare Battle Formations step, this model can join one Guardian Defenders unit from your army (a unit cannot have more than one Support Weapon model joined to it). This model then counts as part of that GUARDIANS unit for the rest of the battle, and that unit’s Starting Strength is increased accordingly.

This model, and any unit it is joined to, cannot embark within a Transport.</characteristic></characteristics></profile><profile id="source-000003911-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Support Weapon, Infantry, Aeldari, Frame, Shadow Weaver Platform</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, , Asuryani</characteristic></characteristics></profile></profiles><rules><rule id="source-000003911-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: shadow weaver; shuriken catapult; close combat weapon.</description></rule><rule id="source-000003911-composition" name="Unit Composition" hidden="false"><description>1 Shadow Weaver Platform</description></rule><rule id="source-000003911-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 60 pts</description></rule></rules><categoryLinks><categoryLink id="source-000003911-role" name="Infantry" targetId="cat-infantry-11e0" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000003911-model-0" name="Shadow Weaver Platform" hidden="false" type="model"><constraints><constraint id="source-000003911-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000003911-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000003911-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000003911-model-0-weapon-0" name="Shadow weaver" hidden="false" type="upgrade