">This model is eligible to shoot and declare a charge in a turn in which it Fell Back.</characteristic></characteristics></profile><profile id="source-000000631-keywords" name="Keywords" hidden="false" typeId="keywords-11e0" typeName="Keywords"><characteristics><characteristic name="Keywords" typeId="unit-keywords-11e0">Phantom Titan, Aeldari, Wraith Construct, Walker, Towering, Titanic, Monster</characteristic><characteristic name="Faction Keywords" typeId="faction-keywords-11e0">Ynnari, Asuryani, </characteristic></characteristics></profile></profiles><rules><rule id="source-000000631-starting" name="Starting Equipment" hidden="false"><description>This model is equipped with: D-bombard; Phantom pulsar; Phantom starcannon; voidstorm missile launcher; Phantom feet.</description></rule><rule id="source-000000631-composition" name="Unit Composition" hidden="false"><description>1 Phantom Titan</description></rule><rule id="source-000000631-option-0" name="Wargear Option 1" hidden="false"><description>This model’s D-bombard can be replaced with one of the following:- 2 Phantom starcannons and 1 wraith glaive
- 1 Phantom starcannon, 1 pulse laser and 1 wraith glaive
- 2 pulse lasers and 1 wraith glaive
- 1 Phantom pulsar</description></rule><rule id="source-000000631-option-1" name="Wargear Option 2" hidden="false"><description>This model’s Phantom pulsar can be replaced with one of the following:- 1 D-bombard
- 2 Phantom starcannons and 1 wraith glaive
- 1 Phantom starcannon, 1 pulse laser and 1 wraith glaive
- 2 pulse lasers and 1 wraith glaive</description></rule><rule id="source-000000631-option-2" name="Wargear Option 3" hidden="false"><description>This model’s Phantom starcannon can be replaced with 1 pulse laser.</description></rule><rule id="source-000000631-points" name="Source Points Table" hidden="false"><description>YOUR UNIT COSTS: 1 model = 2100 pts</description></rule></rules><categoryLinks><categoryLink id="source-000000631-role" name="Monster" targetId="smoke-cat-5" primary="true" hidden="false" /></categoryLinks><selectionEntries><selectionEntry id="source-000000631-model-0" name="Phantom Titan" hidden="false" type="model"><constraints><constraint id="source-000000631-model-0-min" type="min" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000631-model-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="source-000000631-model-0-equipment" name="Wargear (source choices — restrictions shown in Rules)" hidden="false"><selectionEntries><selectionEntry id="source-000000631-model-0-weapon-0" name="D-bombard" hidden="false" type="upgrade"><constraints><constraint id="source-000000631-model-0-weapon-0-min" type="min" field="selections" scope="parent" value="0" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint id="source-000000631-model-0-weapon-0-max" type="max" field="selections" scope="parent" value="1" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="source-000000631-model-0-weapon-0-profile" name="D-bombard" hidden="false" typeId="fd-ranged-type" typeName="Ranged Weapons"><characteristics><characteristic name="Range" typeId="fd-rng">72"</charac